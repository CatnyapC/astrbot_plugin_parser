            "twitter": {
                "name": "Twitter 解析器",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "type": "bool",
                        "default": true
                    },
                    "cookies": {
                        "description": "Cookies",
